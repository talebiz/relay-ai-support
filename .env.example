# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
# docker maybe request with backend name not localhost
# DJANGO_ALLOWED_HOSTS must include the service name "backend" too, 
# since inside Docker the frontend container may reach this service 
# via its compose service name.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# React dev server origin. Needed so the browser (running the Vite app)
# is allowed to call the Django API, which lives on a different origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=relay
POSTGRES_USER=relay_user
POSTGRES_PASSWORD=change-me
# DB_HOST is set in docker-compose.yml itself (service name: postgres),
# not here, since it must always match the service name inside Docker.
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=relay_user
RABBITMQ_PASSWORD=change-me
# Same reasoning as DB_HOST: RABBITMQ_HOST is set in docker-compose.yml,
# not here, so it always matches the service name.
RABBITMQ_PORT=5672
# Queue name used between Django (producer) and the ai-worker (consumer)
# for "command" messages. See README for the command/event distinction.
COMMAND_QUEUE=agent_commands

# --- ChromaDB ---
# CHROMADB_HOST is set in docker-compose.yml (service name: chromadb).
CHROMADB_PORT=8000

# --- LLM provider(s) (ai-worker/llm/factory.py) ---
# PRIMARY is required; FALLBACK is optional (bonus item: "بازگشت خودکار
# به مدل دوم هنگام شکست مدل اول" - automatic fallback to a second model
# when the first fails). PROVIDER must be one of:
#   openai_compatible | google_genai
# "openai_compatible" is not a single vendor - it is any endpoint that
# speaks OpenAI's /chat/completions shape (Groq, OpenRouter, Together,
# local Ollama, ...), which is also how to reach Claude models if you
# want them: point this at OpenRouter rather than adding a provider.
# See a free-tier list here: https://github.com/cheahjs/free-llm-api-resources
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
# Only read when LLM_PRIMARY_PROVIDER=openai_compatible - the base URL
# of whichever OpenAI-compatible free-tier endpoint you're using
# (e.g. Groq, OpenRouter). Leave blank for google_genai.
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_TEMPERATURE=0.2

# Optional second model, tried automatically when the primary fails
# (project brief section 5, bonus: "بازگشت خودکار به مدل دوم هنگام شکست
# مدل اول"). Leave LLM_FALLBACK_PROVIDER empty for no fallback.
#
# The tools are bound to BOTH models, so a failover does not silently
# degrade into a tool-less model answering from memory - see
# ai-worker/llm/factory.py::bind_tools_with_fallback.
#
# A PROVIDER named here with a blank API_KEY (and no BASE_URL) is
# skipped with a notice rather than crashing the worker, so a
# half-filled fallback slot cannot take down the healthy primary.
LLM_FALLBACK_PROVIDER=google_genai
LLM_FALLBACK_MODEL=gemini-2.0-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_TEMPERATURE=0.2

# --- Web search tool ---
TAVILY_API_KEY=

# --- Observability & cost (part 7) ---
# Langfuse is OPTIONAL. Leave the two keys empty and the worker still
# produces its full execution trace: structured [trace] log lines on
# stdout plus one row per run (and per model/tool call) in PostgreSQL,
# which is what the UI's cost panel reads. Set the keys to ALSO get the
# hosted timeline view, deep-linked from each run in the UI.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Ask the provider to report its own token usage on streaming responses
# (sends `stream_options: {"include_usage": true}` for
# openai_compatible). Set to 0 only if your endpoint rejects that field;
# the worker then falls back to counting tokens locally and labels the
# run "estimated" instead of "provider".
LLM_STREAM_USAGE=1

# Reference prices used to turn real token counts into a cost figure.
# The free tier bills nothing; this is what the same traffic WOULD cost
# at list prices - see ai-worker/observability/pricing.py for why the
# project reports that rather than "it was free".
#
# Optional JSON, merged over the built-in table. USD per 1M tokens, as
# [input, output], matched by substring against the model name:
#   LLM_PRICE_TABLE_JSON={"llama-3.3-70b-versatile": [0.59, 0.79]}
LLM_PRICE_TABLE_JSON=
# Used when the model name matches nothing in the table.
LLM_DEFAULT_PRICE_INPUT_PER_MTOK=0.15
LLM_DEFAULT_PRICE_OUTPUT_PER_MTOK=0.60

# Tavily bills CREDITS, not tokens: 1 per basic search, 2 per advanced.
# The credit COUNT is the honest number (it is consumed out of a finite
# monthly allowance even on the free plan); the rate below converts it
# to a dollar figure for the same reason as the token prices above.
TAVILY_CREDITS_PER_SEARCH=1
TAVILY_USD_PER_CREDIT=0.008
