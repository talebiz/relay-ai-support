# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
# docker maybe request with backend name not localhost
# DJANGO_ALLOWED_HOSTS must include the service name "backend" too, 
# since inside Docker the frontend container may reach this service 
# via its compose service name.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# React dev server origin. Needed so the browser (running the Vite app)
# is allowed to call the Django API, which lives on a different origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_DB=relay
POSTGRES_USER=relay_user
POSTGRES_PASSWORD=change-me
# DB_HOST is set in docker-compose.yml itself (service name: postgres),
# not here, since it must always match the service name inside Docker.
DB_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=relay_user
RABBITMQ_PASSWORD=change-me
# Same reasoning as DB_HOST: RABBITMQ_HOST is set in docker-compose.yml,
# not here, so it always matches the service name.
RABBITMQ_PORT=5672
# Queue name used between Django (producer) and the ai-worker (consumer)
# for "command" messages. See README for the command/event distinction.
COMMAND_QUEUE=agent_commands

# --- ChromaDB ---
# CHROMADB_HOST is set in docker-compose.yml (service name: chromadb).
CHROMADB_PORT=8000

# --- LLM provider(s) (ai-worker/llm/factory.py) ---
# PRIMARY is required; FALLBACK is optional (bonus item: "بازگشت خودکار
# به مدل دوم هنگام شکست مدل اول" - automatic fallback to a second model
# when the first fails). PROVIDER must be one of:
#   openai_compatible | anthropic | google_genai
# See a free-tier list here: https://github.com/cheahjs/free-llm-api-resources
LLM_PRIMARY_PROVIDER=openai_compatible
LLM_PRIMARY_MODEL=
LLM_PRIMARY_API_KEY=
# Only read when LLM_PRIMARY_PROVIDER=openai_compatible - the base URL
# of whichever OpenAI-compatible free-tier endpoint you're using
# (e.g. Groq, OpenRouter). Leave blank for anthropic/google_genai.
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_TEMPERATURE=0.2

# Leave LLM_FALLBACK_PROVIDER empty to run with no fallback configured.
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_TEMPERATURE=0.2

# --- Web search tool ---
TAVILY_API_KEY=

# --- Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
